// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  role      String   @default("ADMIN")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  logoUrl       String?
  bannerUrl     String?
  description   String?   @db.Text
  markupPercent Float     @default(10)
  menuSection   String    @default("topup") // topup, voucher, pulsa, token, data
  field1Label   String    @default("User ID") // Label untuk input utama (contoh: "User ID", "Riot ID", "Nomor HP")
  field2Label   String?   // Label untuk input opsional (contoh: "Zone ID", "Tagline"). Jika null, tidak tampilkan input kedua.
  digiflazzBrand String?  // Brand name persis dari Digiflazz (e.g., "Mobile Legends", "Free Fire")
  products      Product[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Product {
  id            String   @id @default(cuid())
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  skuCode       String   @unique // Digiflazz SKU
  name          String
  basicPrice    Float    // Modal dari Digiflazz
  sellPrice     Float    // Harga jual ke pelanggan
  maxPrice      Float    // Hard Guard (Batas aman)
  status        String   @default("active") // active, inactive
  imageUrl      String?  // URL gambar produk (local: /uploads/xxx.png)
  isFlashSale   Boolean  @default(false) // Tampilkan di flash sale
  flashSalePrice Float?  // Harga khusus flash sale
  isPopular     Boolean  @default(false) // Tampilkan di produk populer
  orderCount    Int      @default(0) // Jumlah transaksi (untuk populer)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
}

model Order {
  id            String   @id @default(cuid())
  referenceId   String   @unique // Order ID internal
  userGameId    String   // ID Game tujuan (misal ID MLBB)
  zoneId        String?  // Server/Zone ID (opsional)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  paymentStatus String   @default("PENDING") // PENDING, LUNAS, EXPIRED, FAILED
  digiflazzStatus String @default("PENDING") // PENDING, PROCESSING, SUCCESS, FAILED
  amount        Float
  paymentFee    Float?   // Biaya admin total (fee Sukurupiah + fixed fee)
  
  // Sukurupiah Payment Gateway Fields
  sakurupiahTrxId    String?   // trx_id dari Sukurupiah
  sakurupiahStatus   String?   // pending, berhasil, expired
  paymentMethod      String?   // QRIS, BCAVA, DANA, GOPAY, etc
  paymentQrCode      String?   // QR Code (base64) untuk QRIS
  paymentNo          String?   // Nomor Virtual Account
  checkoutUrl        String?   // URL checkout untuk e-wallet redirect
  expiredAt          DateTime? // Batas waktu pembayaran
  isPaymentProcessed Boolean   @default(false) // Idempotency flag
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Settings {
  id              String   @id @default(cuid())
  key             String   @unique
  value           String   @db.Text
  description     String?
}

model ErrorLog {
  id          String   @id @default(cuid())
  service     String   // Digiflazz, Sukurupiah, System
  message     String   @db.Text
  responseBody String? @db.LongText
  createdAt   DateTime @default(now())
}
